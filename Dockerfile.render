# --- STAGE 1: Build & Package the Multi-Module Monolith ---
FROM maven:3.9.6-eclipse-temurin-21-jammy AS builder
WORKDIR /build

# 1. Copy the parent POM file
COPY pom.xml .

# 2. Copy the pom.xml files for ALL child modules
COPY entos-api/pom.xml entos-api/
COPY entos-identity/pom.xml entos-identity/
COPY entos-shared/pom.xml entos-shared/
COPY entos-infra/pom.xml entos-infra/
COPY entos-cafe/pom.xml entos-cafe/
COPY entos-social/pom.xml entos-social/
COPY entos-platform/pom.xml entos-platform/

RUN mvn dependency:go-offline -B

# 3. Copy everything else in the project folder at once.
COPY . .

RUN mvn clean install -DskipTests

# --- STAGE 2: Ultra-lightweight Runtime Environment ---
FROM eclipse-temurin:21-jre-jammy
WORKDIR /app

# Create a non-root system user for production security hardening
RUN groupadd -r entosuser && useradd -r -g entosuser entosuser

# Extract only the final executable fat JAR file from the builder stage
COPY --from=builder /build/entos-api/target/entos-api-*.jar app.jar

RUN chown -R entosuser:entosuser /app
USER entosuser

# Render maps web traffic dynamically to port 10000 by default
EXPOSE 10000

ENTRYPOINT ["java", "-jar", "app.jar"]